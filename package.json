{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "implementção do https://www.tabnews.com.br para o https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "bash -c 'trap \"npm run _dev_cleanup\" EXIT; npm run services:up && npm run services:wait:db && npm run migrations:up && next dev'",
    "_dev_cleanup": "npm run services:stop",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\" ",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:wait:db": "node infra/scripts/wait-for-db.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:down": "node-pg-migrate -m infra/migrations down",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "prepare": "husky",
    "commit": "cz",
    "scan:staged": "gitleaks-secret-scanner",
    "scan:all": "gitleaks-secret-scanner --diff-mode all",
    "scan:history": "gitleaks-secret-scanner --diff-mode history"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "17.3.1",
    "dotenv-expand": "12.0.3",
    "lucide-react": "0.577.0",
    "next": "16.1.6",
    "next-connect": "^1.0.0",
    "node-pg-migrate": "8.0.4",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "autoprefixer": "10.4.27",
    "babel-jest": "^30.4.1",
    "commitizen": "4.3.1",
    "concurrently": "9.2.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "29.15.0",
    "gitleaks-secret-scanner": "2.1.1",
    "globals": "^17.4.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "postcss": "8.5.8",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
